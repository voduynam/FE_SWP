    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('Status is 2xx', function () {",
          "  pm.expect(pm.response.code).to.be.within(200, 299);",
          "});"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 - Store Staff",
      "item": [
        {
          "name": "Login - Store Staff",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login success', function () {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "const json = pm.response.json();",
                  "const token = json?.data?.token || json?.token;",
                  "pm.expect(token, 'Token should exist').to.be.a('string');",
                  "pm.environment.set('storeToken', token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{storeUsername}}\",\n  \"password\": \"{{storePassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "Get Internal Orders (SUBMITTED)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{storeToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/internal-orders?status=SUBMITTED&limit=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "internal-orders"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "SUBMITTED"
                },
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            }
          }
        },
